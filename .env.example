# ── Zeno AI server ────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# Secret used to encrypt provider and connector credentials at rest
# (AES-256-GCM) and to sign session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ZENO_SECRET=change-me-generate-a-long-random-string

# Comma-separated list of allowed origins for CORS (the bundled frontend is
# same-origin by default, so this only matters if you host the UI elsewhere).
ZENO_CORS_ORIGINS=

# ── Persistence ───────────────────────────────────────────────────────────────
# When set, Zeno uses PostgreSQL for all persistent data (recommended in
# production; enable the pgvector extension for semantic memory). When unset,
# Zeno uses an embedded SQLite database under ./data — zero-config, fully
# functional, same schema and repositories.
# DATABASE_URL=postgres://zeno:zeno@localhost:5432/zeno

# ── Queues / cache ────────────────────────────────────────────────────────────
# When set, background jobs (agent runs, memory extraction) are coordinated
# through Redis. When unset, Zeno uses a durable DB-backed queue with an
# in-process worker.
# REDIS_URL=redis://localhost:6379

# ── Sandboxed execution ───────────────────────────────────────────────────────
# Terminal / code-execution tools route to an isolated Docker sandbox when this
# URL is set (see deploy/sandbox). When unset they run in a restricted local
# child process inside the per-user workspace, gated behind explicit approval.
# ZENO_SANDBOX_URL=http://127.0.0.1:8090

# ── Agent runtime ─────────────────────────────────────────────────────────────
# Context engine budget in characters (system prompt + history + tool output).
# When a model registers a context window, Zeno derives the budget from it and
# only falls back to this for unknown models.
# ZENO_CONTEXT_CHAR_BUDGET=96000

# ── Intelligence layer (Jev decision engine / routing / cost) ─────────────────
# Per-user behavior is configured in the UI under Settings → Intelligence and
# Settings → Cost & Usage. These env vars set server-level bounds only.
# Remote Jev decision timeout (ms): an external decision provider that has not
# answered within this bound falls back to the built-in deterministic router.
# ZENO_DECISION_TIMEOUT_MS=2500
# Retry budget for transient/rate-limit/network model failures (spec: retry
# only what can plausibly succeed; permanent errors fail fast).
# ZENO_MODEL_RETRY_ATTEMPTS=2
# ZENO_MODEL_RETRY_BASE_MS=500
# ZENO_MODEL_RETRY_MAX_MS=8000
# Research workflow bounds per research turn (parallel sub-queries / page reads).
# ZENO_RESEARCH_MAX_SUBQUERIES=4
# ZENO_RESEARCH_MAX_READS=3
# Upper bound on tools dispatched concurrently in one round (non-sensitive only).
# ZENO_MAX_PARALLEL_TOOLS=6

# ── Local computer bridge ─────────────────────────────────────────────────────
# Lets the agent read/write files OUTSIDE the per-user workspace on the machine
# running the server (Desktop, Documents, …) through the local_* tools. Disabled
# unless explicitly enabled. Paths are restricted to the roots below; every call
# still respects the user's permission mode (Ask Before Change / Workspace Edit
# / Full Access) and lands in the audit log. When Zeno runs on your own
# computer, root it at your user folders; when deployed on a server, root it at
# whatever mounted directories that environment is allowed to touch.
# Separate multiple roots with ";" on Windows or "," elsewhere.
# ZENO_LOCAL_BRIDGE=1
# ZENO_LOCAL_ROOTS=C:\Users\you\Desktop;C:\Users\you\Documents;C:\Users\you\Downloads
# Per-file read/write caps in MB (default 4 each).
# ZENO_LOCAL_MAX_READ_MB=4
# ZENO_LOCAL_MAX_WRITE_MB=4

# ── Object storage ────────────────────────────────────────────────────────────
# Uploads are stored on the local filesystem under ./data/files by default.
# ZENO_DATA_DIR=./data

# ── Web search ────────────────────────────────────────────────────────────────
# The web_search tool works keyless via DuckDuckGo. Configure a Tavily or
# Brave Search key for higher quality/rate limits.
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── Connectors (HTTP plugins / remote MCP) ────────────────────────────────────
# Connectors are per-user and configured in the UI under "Tools & connections".
# Endpoints must be public Internet HTTP(S) hosts; private ranges, link-local
# addresses, and cloud metadata endpoints are always blocked. No server-level
# configuration is required.
